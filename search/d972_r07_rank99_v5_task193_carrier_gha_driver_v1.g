#############################################################################
## Task496 rank-99 v5 to Task193 carrier: positive-only handoff driver.
#############################################################################
if not IsBound(D972_R07_RANK99_V5_TASK193_CARRIER_V1_RUN) or D972_R07_RANK99_V5_TASK193_CARRIER_V1_RUN<>true then Error("task496 carrier external preamble required");fi;;
if not IsBound(D496V5Result) or not IsBound(D496V5Checkpoint) or not IsBound(D496V5CheckerLog) or not IsBound(D496SourceHead) or not IsBound(D496RunId) or not IsBound(D496ArtifactId) then Error("task496 v5 inputs required");fi;;
D496P:="search/d972_r07_rank99_v5_task193_carrier_v1.py";;D496C:="crosscheck/check_d972_r07_rank99_v5_task193_carrier_v1.py";;D496PB:=17290;;D496PS:="34983cfaec66f426bdfc63eae5230c27a34f02c847f6154ba81771e6c995b0cd";;D496CB:=17400;;D496CS:="fde1cf20ed2111bddabb47abd8fd6c165db3f6e4f4c00a4acf493ceb9c0f169b";;
D496Read:=function(p)local x;x:=StringFile(p);if x=fail then Error("task496 carrier missing ",p);fi;return x;end;;D496Pin:=function(p,n,s)local x;x:=D496Read(p);if Length(x)<>n or HexSHA256(x)<>s then Error("task496 carrier pin drift ",p);fi;end;;D496Nonempty:=function(p,l)local x;x:=D496Read(p);if Length(x)=0 then Error("task496 carrier empty ",l);fi;return true;end;;D496Owned:=function(p,s,l)local x,z,n;x:=D496Read(p);if Length(x)=0 or PositionSublist(x,"UNKNOWN")<>fail or PositionSublist(x,"ERROR")<>fail or PositionSublist(x,"Traceback")<>fail then Error("task496 carrier bad ",l);fi;z:=SplitString(x,"\n");n:=Number(z,q->q=s);if n<>1 then Error("task496 carrier sentinel ",l);fi;return true;end;;
D496Pin(D496P,D496PB,D496PS);;D496Pin(D496C,D496CB,D496CS);;
D496Out:="ci/out/d972_r07_rank99_v5_task193_carrier_v1.json";;D496Verdict:="ci/out/d972_r07_rank99_v5_task193_carrier_v1_checker.json";;D496PL:="ci/out/d972_r07_rank99_v5_task193_carrier_v1_producer.log";;D496CL:="ci/out/d972_r07_rank99_v5_task193_carrier_v1_checker.log";;
Exec("mkdir -p ci/out");;if IsExistingFile(D496Out) or IsExistingFile(D496Verdict) then Error("task496 carrier stale output");fi;;
Exec(Concatenation("python3 -u -B ",D496P," --v5-result ",D496V5Result," --v5-checkpoint ",D496V5Checkpoint," --v5-checker-log ",D496V5CheckerLog," --source-head ",D496SourceHead," --run-id ",String(D496RunId)," --artifact-id ",String(D496ArtifactId)," --output ",D496Out," 2>&1 | tee ",D496PL));;
D496Owned(D496PL,"R07_RANK99_V5_TASK193_CARRIER_V1 status=ACCEPTED","producer");;D496Nonempty(D496Out,"receipt");;
Exec(Concatenation("python3 -u -B ",D496C," --carrier ",D496Out," --v5-result ",D496V5Result," --v5-checkpoint ",D496V5Checkpoint," --v5-checker-log ",D496V5CheckerLog," --source-head ",D496SourceHead," --run-id ",String(D496RunId)," --artifact-id ",String(D496ArtifactId)," --output ",D496Verdict," 2>&1 | tee ",D496CL));;
D496Owned(D496CL,"R07_RANK99_V5_TASK193_CARRIER_V1_CHECKER_PASS","checker");;D496Nonempty(D496Verdict,"verdict");;Print("R07_RANK99_V5_TASK193_CARRIER_V1_DRIVER_PASS\n");;
