D431RecoveryCommand:=Concatenation("bash -lc 'set -eu; mkdir -p ci/in; test ! -e ",D431RecoveryReceipt,"; test ! -L ",D431RecoveryReceipt,"; if [ -e ",D431RecoveryZip," ] || [ -L ",D431RecoveryZip," ] || [ -e ",D431Input," ] || [ -L ",D431Input," ] || [ -e ",D431RecoverySeal," ] || [ -L ",D431RecoverySeal," ]; then names=$(unzip -Z1 ci/in/d972_r07_a0_pb34_recovery.zip); test \"$(printf \"%s\\n\" \"$names\" | wc -l)\" -eq 6; test \"$(printf \"%s\\n\" \"$names\" | sort -u | wc -l)\" -eq 6; test \"$(printf \"%s\\n\" \"$names\" | grep -Fxc \"d972_r07_a0_pb34_direct_quotient_owner_v12.json\")\" -eq 1; test \"$(printf \"%s\\n\" \"$names\" | grep -Fxc \"d972_r07_a0_pb34_direct_quotient_owner_v12_checker.log\")\" -eq 1; test \"$(printf \"%s\\n\" \"$names\" | grep -Fxc \"d972_r07_a0_pb34_direct_quotient_owner_v12_output.checkpoint\")\" -eq 1; test \"$(printf \"%s\\n\" \"$names\" | grep -Fxc \"d972_r07_a0_pb34_direct_quotient_owner_v12_producer.log\")\" -eq 1; test \"$(printf \"%s\\n\" \"$names\" | grep -Fxc \"driver.g\")\" -eq 1; test \"$(printf \"%s\\n\" \"$names\" | grep -Fxc \"run.log\")\" -eq 1; test -f ",D431RecoveryZip,"; test -f ",D431Input,"; test -f ",D431RecoverySeal,"; test ! -L ",D431RecoveryZip,"; test ! -L ",D431Input,"; test ! -L ",D431RecoverySeal,"; test \"$(wc -c < ",D431RecoveryZip,")\" -eq ",String(D431RecoveryZipBytes),"; printf \"%s  %s\\n\" \"",D431RecoveryZipSHA,"\" ",D431RecoveryZip," | sha256sum -c -; test \"$(wc -c < ",D431Input,")\" -eq ",String(D431RecoveryBytes),"; printf \"%s  %s\\n\" \"",D431RecoverySHA,"\" ",D431Input," | sha256sum -c -; test \"$(cat ",D431RecoverySeal,")\" = \"D972-A0V12-RECOVERY-SEAL1 ",D431RecoveryZipSHA," ",D431RecoverySHA,"\"; else ztmp=$(mktemp ci/in/d972-r07-a0-recovery-XXXXXX.zip.tmp); cptmp=$(mktemp ci/out/d972-r07-a0-recovery-XXXXXX.checkpoint.tmp); trap \"rm -f \\\"$ztmp\\\" \\\"$cptmp\\\"\" EXIT; curl --fail --location --retry 3 --output \"$ztmp\" ",D431RecoveryURL,"; test \"$(wc -c < \"$ztmp\")\" -eq ",String(D431RecoveryZipBytes),"; printf \"%s  %s\\n\" \"",D431RecoveryZipSHA,"\" \"$ztmp\" | sha256sum -c -; names=$(unzip -Z1 \"$ztmp\"); test \"$(printf \"%s\\n\" \"$names\" | wc -l)\" -eq 6; test \"$(printf \"%s\\n\" \"$names\" | sort -u | wc -l)\" -eq 6; test \"$(printf \"%s\\n\" \"$names\" | grep -Fxc \"d972_r07_a0_pb34_direct_quotient_owner_v12.json\")\" -eq 1; test \"$(printf \"%s\\n\" \"$names\" | grep -Fxc \"d972_r07_a0_pb34_direct_quotient_owner_v12_checker.log\")\" -eq 1; test \"$(printf \"%s\\n\" \"$names\" | grep -Fxc \"d972_r07_a0_pb34_direct_quotient_owner_v12_output.checkpoint\")\" -eq 1; test \"$(printf \"%s\\n\" \"$names\" | grep -Fxc \"d972_r07_a0_pb34_direct_quotient_owner_v12_producer.log\")\" -eq 1; test \"$(printf \"%s\\n\" \"$names\" | grep -Fxc \"driver.g\")\" -eq 1; test \"$(printf \"%s\\n\" \"$names\" | grep -Fxc \"run.log\")\" -eq 1; unzip -p \"$ztmp\" \"",D431RecoveryEntry,"\" > \"$cptmp\"; test \"$(wc -c < \"$cptmp\")\" -eq ",String(D431RecoveryBytes),"; printf \"%s  %s\\n\" \"",D431RecoverySHA,"\" \"$cptmp\" | sha256sum -c -; test ! -e ",D431RecoveryZip,"; test ! -L ",D431RecoveryZip,"; test ! -e ",D431Input,"; test ! -L ",D431Input,"; test ! -e ",D431RecoverySeal,"; test ! -L ",D431RecoverySeal,"; mv \"$ztmp\" ",D431RecoveryZip,"; mv \"$cptmp\" ",D431Input,"; printf \"D972-A0V12-RECOVERY-SEAL1 ",D431RecoveryZipSHA," ",D431RecoverySHA,"\\n\" > ",D431RecoverySeal,"; chmod 600 ",D431RecoverySeal,"; fi; rtmp=$(mktemp ci/in/d972-r07-a0-recovery-XXXXXX.receipt.tmp); printf \"%s\\n\" \"",D431RecoveryReceiptText,"\" > \"$rtmp\"; mv \"$rtmp\" ",D431RecoveryReceipt,"; trap - EXIT' ");;Exec(D431RecoveryCommand);;if not IsExistingFile(D431RecoveryReceipt) then Error("task431 recovery receipt missing");fi;;if D431Read(D431RecoveryReceipt)<>Concatenation(D431RecoveryReceiptText,"\n") then Error("task431 recovery receipt mismatch");fi;;if not IsExistingFile(D431RecoverySeal) then Error("task431 recovery artifact not authenticated");fi;;
