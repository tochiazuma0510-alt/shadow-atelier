fi;
SetPrintFormattingStatus(P159OR36P2W4Out,false);
PrintTo(P159OR36P2W4Out,P159OR36P2W4Results,"\n");
CloseStream(P159OR36P2W4Out);
P159OR36P2W4Raw:=StringFile(P159OR36P2W4OutputPath);;
if P159OR36P2W4Raw=fail then
