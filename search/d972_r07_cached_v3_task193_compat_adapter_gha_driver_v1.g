 PrintTo(D197S,"if ! python3 -u -B ",D197Producer," --mode PRODUCTION --phase FINALIZE --v3-receipt ",D197V3Receipt," --v3-attestation ",D197V3Attestation," --v2-receipt ",D197V2Receipt," --v2-attestation ",D197V2Attestation," --prepared ",D197Prepared," --certificate ",D197Certificate," --run-id ",D197RunId," --head-sha ",D197HeadSha," --artifact-id ",D197ArtifactId," --artifact-name ",D197ArtifactName," --zip-sha256 ",D197ZipSha256," --member-path task192_v3_receipt.json --member-bytes ",D197MemberBytes," --member-sha256 ",D197MemberSha256," > ",D197ProducerLog," 2>&1; then cat ",D197ProducerLog,"; exit 1; fi\ncat ",D197ProducerLog,"\ntest \"$(wc -l < ",D197ProducerLog,")\" -eq 1\ngrep -Fxc '",COMMON,"_FINALIZE_PASS terminal=",COMMON,"' ",D197ProducerLog," | grep -qx 1\n");
 PrintTo(D197S,"if ! python3 -u -B ",D197Checker," ",D197V3Receipt," --v2-receipt ",D197V2Receipt," --certificate ",D197Certificate," --v3-attestation ",D197V3Attestation," --v2-attestation ",D197V2Attestation," --run-id ",D197RunId," --head-sha ",D197HeadSha," --artifact-id ",D197ArtifactId," --artifact-name ",D197ArtifactName," --zip-sha256 ",D197ZipSha256," --member-path task192_v3_receipt.json --member-bytes ",D197MemberBytes," --member-sha256 ",D197MemberSha256," > ",D197CheckerLog," 2>&1; then cat ",D197CheckerLog,"; exit 1; fi\ncat ",D197CheckerLog,"\ntest \"$(wc -l < ",D197CheckerLog,")\" -eq 1\nIFS= read -r adapter_checker_line < ",D197CheckerLog,"\ntest \"$adapter_checker_line\" = '",COMMON,"_CHECKER_PASS terminal=",COMMON,"'\n");
 PrintTo(D197S,"producer_terminal=\"$(sed -n 's/^",COMMON,"_FINALIZE_PASS terminal=//p' ",D197ProducerLog,")\"\nchecker_terminal=\"$(sed -n 's/^",COMMON,"_CHECKER_PASS terminal=//p' ",D197CheckerLog,")\"\ntest \"$producer_terminal\" = \"$checker_terminal\"\n");
fi;
PrintTo(D197S,"printf '%s\\n' '",COMMON,"_OK' > ",D197Quote(D197OK),"\ntest \"$(cat ",D197Quote(D197OK),")\" = '",COMMON,"_OK'\n");CloseStream(D197S);;
