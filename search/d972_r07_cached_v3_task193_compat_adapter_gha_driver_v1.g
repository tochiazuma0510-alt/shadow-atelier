else
 PrintTo(D197S,"expected_member_sha=\"$(printf '%s' ",D197MemberSha256," | tr '[:upper:]' '[:lower:]')\"\ncheck_v3_identity() { test \"$(wc -c < ",D197V3Receipt,")\" -eq ",D197MemberBytes,"; test \"$(sha256sum ",D197V3Receipt," | awk '{print $1}')\" = \"$expected_member_sha\"; }\ncheck_v3_identity\n");
 PrintTo(D197S,"if ! python3 -u -B ",D197V3Checker," ",D197V3Receipt," > ",D197V3Log," 2>&1; then cat ",D197V3Log,"; exit 1; fi\ncheck_v3_identity\ncat ",D197V3Log,"\ntest \"$(wc -l < ",D197V3Log,")\" -eq 1\nIFS= read -r v3_line < ",D197V3Log,"\ntest \"$v3_line\" = '",V3_LINE,"'\nprintf '%s\\n' \"$v3_line\" > ",D197V3Attestation,"\n");
 PrintTo(D197S,"if ! python3 -u -B ",D197Producer," --mode PRODUCTION --phase PREPARE --v3-receipt ",D197V3Receipt," --v3-attestation ",D197V3Attestation," --v2-receipt ",D197V2Receipt," --prepared ",D197Prepared," --run-id ",D197RunId," --head-sha ",D197HeadSha," --artifact-id ",D197ArtifactId," --artifact-name ",D197ArtifactName," --zip-sha256 ",D197ZipSha256," --member-path task192_v3_receipt.json --member-bytes ",D197MemberBytes," --member-sha256 ",D197MemberSha256," > ",D197ProducerLog," 2>&1; then cat ",D197ProducerLog,"; exit 1; fi\ncat ",D197ProducerLog,"\ntest \"$(wc -l < ",D197ProducerLog,")\" -eq 1\ngrep -Fxc '",COMMON,"_PREPARE_PASS' ",D197ProducerLog," | grep -qx 1\n");
