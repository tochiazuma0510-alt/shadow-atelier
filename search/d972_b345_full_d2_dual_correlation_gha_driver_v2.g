D972FDC2Read := function(path,label)
  local raw;
  raw:=StringFile(path);;
  if raw=fail or Length(raw)=0 then Error("157eh driver: missing ",label); fi;
  return raw;
end;;

D972FDC2RequireSHA := function(path,expected)
  local raw,got;
  raw:=D972FDC2Read(path,path);; got:=HexSHA256(raw);;
  if got<>expected then Error("157eh driver: SHA drift ",path," got=",got); fi;
  return true;
end;;

D972FDC2Count := function(text,needle)
  local i,n,m,count;
  if not IsString(text) or not IsString(needle) or Length(needle)=0 then
    Error("157eh driver: occurrence input");
  fi;
  n:=Length(text);; m:=Length(needle);; count:=0;;
  if n<m then return 0; fi;
  for i in [1..n-m+1] do
    if text{[i..i+m-1]}=needle then count:=count+1;; fi;
  od;
  return count;
end;;

D972FDC2Write := function(path,text)
  local stream,got;
  stream:=OutputTextFile(path,false);;
  if stream=fail then Error("157eh driver: child write open"); fi;
  SetPrintFormattingStatus(stream,false);; PrintTo(stream,text);; CloseStream(stream);;
  got:=StringFile(path);;
  if got=fail or got<>text then Error("157eh driver: child readback"); fi;
  return true;
end;;

for D972FDC2Source in [
  [D972FDC2Producer,D972FDC2ProducerSHA],
  [D972FDC2Checker,D972FDC2CheckerSHA],
  [D972FDC2Task,D972FDC2TaskSHA],
  [D972FDC2V1Producer,D972FDC2V1ProducerSHA],
  [D972FDC2V1Checker,D972FDC2V1CheckerSHA],
  [D972FDC2V1Driver,D972FDC2V1DriverSHA],
  [D972FDC2V1Task,D972FDC2V1TaskSHA],
  [D972FDC2V1Reply,D972FDC2V1ReplySHA],
  [D972FDC2EDProducer,D972FDC2EDProducerSHA],
  [D972FDC2EDChecker,D972FDC2EDCheckerSHA],
  [D972FDC2EDDriver,D972FDC2EDDriverSHA],
  [D972FDC2EEProducer,D972FDC2EEProducerSHA],
  [D972FDC2EFChecker,D972FDC2EFCheckerSHA],
  [D972FDC2EFDriver,D972FDC2EFDriverSHA],
  [D972FDC2Prefix,D972FDC2PrefixSHA],
  [D972FDC2Q3Producer,D972FDC2Q3ProducerSHA],
  [D972FDC2Q3Checker,D972FDC2Q3CheckerSHA],
  [D972FDC2Q3Driver,D972FDC2Q3DriverSHA]
] do
  D972FDC2RequireSHA(D972FDC2Source[1],D972FDC2Source[2]);;
od;

D972FDC2Self:=IsBound(D972_B345_FULL_D2_DUAL_CORRELATION_V2_SELFTEST) and
  D972_B345_FULL_D2_DUAL_CORRELATION_V2_SELFTEST=true;;
D972FDC2Run:=IsBound(D972_B345_FULL_D2_DUAL_CORRELATION_V2_RUN) and
  D972_B345_FULL_D2_DUAL_CORRELATION_V2_RUN=true;;
if D972FDC2Self=D972FDC2Run then
  Error("157eh driver: select exactly one boolean mode");
fi;
if IsBound(D972_B345_FULL_D2_DUAL_CORRELATION_V2_OUTPUT) and
   D972_B345_FULL_D2_DUAL_CORRELATION_V2_OUTPUT<>D972FDC2Artifact then
  Error("157eh driver: optional output differs from fixed artifact");
fi;

if D972FDC2Self then
  Exec("mkdir -p 'ci/out' && rm -f 'ci/out/d972_b345_full_d2_dual_correlation_v2_selftest.log' 'ci/out/d972_b345_full_d2_dual_correlation_v2_selftest.ok' && python3 -u -B search/d972_b345_full_d2_dual_correlation_v2.py --self-test > 'ci/out/d972_b345_full_d2_dual_correlation_v2_selftest.log' 2>&1 && python3 -u -B search/check_d972_b345_full_d2_dual_correlation_v2.py --self-test >> 'ci/out/d972_b345_full_d2_dual_correlation_v2_selftest.log' 2>&1 && printf '%s' 'D972_B345_FULL_D2_DUAL_CORRELATION_V2_SELFTEST_EXIT_ZERO' > 'ci/out/d972_b345_full_d2_dual_correlation_v2_selftest.ok'");;
  if D972FDC2Read(D972FDC2SelfOk,"selftest sentinel")<>
       "D972_B345_FULL_D2_DUAL_CORRELATION_V2_SELFTEST_EXIT_ZERO" then
    Error("157eh driver: selftest sentinel");
  fi;
  D972FDC2SelfRaw:=D972FDC2Read(D972FDC2SelfLog,"selftest log");;
  if D972FDC2Count(D972FDC2SelfRaw,
       "D972_B345_FULL_D2_DUAL_CORRELATION_V2_PRODUCER_SELFTEST_PASS")<>1 or
     D972FDC2Count(D972FDC2SelfRaw,
       "D972_B345_FULL_D2_DUAL_CORRELATION_V2_CHECKER_SELFTEST_PASS")<>1 then
    Error("157eh driver: combined selftest markers");
  fi;
  Print(D972FDC2SelfRaw,
    "\nB345_FULL_D2_DUAL_CORRELATION_V2_GHA_DRIVER_PASS mode=selftest\n");;
else
  Exec("mkdir -p 'ci/out' && rm -f 'ci/out/d972_b345_q3_chief_v1.json' 'ci/out/d972_b345_q3_checker_full.log' 'ci/out/d972_b345_q3_checker_full.ok' 'ci/out/d972_b345_full_d2_dual_correlation_v2_q3_child.g' 'ci/out/d972_b345_full_d2_dual_correlation_v2_q3_child.log' 'ci/out/d972_b345_full_d2_dual_correlation_v2_q3_child.ok' 'ci/out/d972_b345_full_d2_dual_correlation_v2.json' 'ci/out/d972_b345_full_d2_dual_correlation_v2_producer.log' 'ci/out/d972_b345_full_d2_dual_correlation_v2_checker.log' 'ci/out/d972_b345_full_d2_dual_correlation_v2_math.ok' 'ci/out/d972_b345_full_d2_dual_correlation_v2_timing.txt'");;
  D972FDC2Q3Text:=Concatenation(
    "if GAPInfo.Version<>\"4.16.0\" then Error(\"GAP 4.16.0 required\"); fi;;\n",
    "if LoadPackage(\"smallgrp\")<>true then Error(\"smallgrp LoadPackage failed\"); fi;;\n",
    "if LoadPackage(\"autpgrp\")<>true then Error(\"autpgrp LoadPackage failed\"); fi;;\n",
    "if LoadPackage(\"anupq\")<>true then Error(\"anupq LoadPackage failed\"); fi;;\n",
    "if LoadPackage(\"json\")<>true then Error(\"json LoadPackage failed\"); fi;;\n",
    "D972_B345_Q3_RUN:=true;; D972_B345_Q3_OUTPUT:=\"ci/out/d972_b345_q3_chief_v1.json\";;\n",
    "Read(\"search/d972_b345_q3_gha_driver_v1.g\");; QUIT_GAP(0);;\n");;
  D972FDC2Write(D972FDC2Q3Child,D972FDC2Q3Text);;
  Exec("bash -o pipefail -c 'gap -l \";/usr/share/gap;/usr/lib/gap;${GAP_P2_PACKAGE_ROOT:?}\" --quitonbreak -q -o 12g ci/out/d972_b345_full_d2_dual_correlation_v2_q3_child.g 2>&1 | tee ci/out/d972_b345_full_d2_dual_correlation_v2_q3_child.log' && printf '%s' 'D972_B345_FULL_D2_DUAL_CORRELATION_V2_Q3_EXIT_ZERO' > 'ci/out/d972_b345_full_d2_dual_correlation_v2_q3_child.ok'");;
  if D972FDC2Read(D972FDC2Q3Ok,"q3 sentinel")<>
       "D972_B345_FULL_D2_DUAL_CORRELATION_V2_Q3_EXIT_ZERO" then
    Error("157eh driver: q3 child");
  fi;
  D972FDC2Q3Raw:=D972FDC2Read(D972FDC2Q3Artifact,"q3 artifact");;
  if HexSHA256(D972FDC2Q3Raw)<>D972FDC2Q3ArtifactSHA then
    Error("157eh driver: q3 artifact SHA");
  fi;
  Exec("bash -o pipefail -c 'python3 -u -B search/check_d972_b345_q3_chief_v1.py ci/out/d972_b345_q3_chief_v1.json > ci/out/d972_b345_q3_checker_full.log 2>&1 && printf %s D972_B345_Q3_CHECKER_FULL_EXIT_ZERO > ci/out/d972_b345_q3_checker_full.ok'");;
  D972FDC2Q3Check:=D972FDC2Read("ci/out/d972_b345_q3_checker_full.log","q3 checker");;
  if D972FDC2Read("ci/out/d972_b345_q3_checker_full.ok","q3 checker sentinel")<>
       "D972_B345_Q3_CHECKER_FULL_EXIT_ZERO" or
     D972FDC2Count(D972FDC2Q3Check,"B345_Q3_CHECKER_PASS")<>1 then
    Error("157eh driver: q3 independent checker");
  fi;
  Exec("bash -o pipefail -c 'set -e; SECONDS=0; python3 -u -B search/d972_b345_full_d2_dual_correlation_v2.py --q3 ci/out/d972_b345_q3_chief_v1.json --output ci/out/d972_b345_full_d2_dual_correlation_v2.json --seconds 18000 2>&1 | tee ci/out/d972_b345_full_d2_dual_correlation_v2_producer.log; producer_elapsed=$SECONDS; remaining=$((18000-SECONDS)); if [ $remaining -le 0 ]; then exit 97; fi; python3 -u -B search/check_d972_b345_full_d2_dual_correlation_v2.py --q3 ci/out/d972_b345_q3_chief_v1.json --receipt ci/out/d972_b345_full_d2_dual_correlation_v2.json --seconds $remaining 2>&1 | tee ci/out/d972_b345_full_d2_dual_correlation_v2_checker.log; final_elapsed=$SECONDS; final_remaining=$((18000-final_elapsed)); if [ $final_remaining -le 0 ]; then exit 98; fi; printf \"producer_elapsed=%s\\nchecker_initial_remaining=%s\\nfinal_elapsed=%s\\nfinal_margin=%s\\n\" $producer_elapsed $remaining $final_elapsed $final_remaining > ci/out/d972_b345_full_d2_dual_correlation_v2_timing.txt; printf %s D972_B345_FULL_D2_DUAL_CORRELATION_V2_MATH_EXIT_ZERO > ci/out/d972_b345_full_d2_dual_correlation_v2_math.ok'");;
  if D972FDC2Read(D972FDC2MathOk,"math sentinel")<>
       "D972_B345_FULL_D2_DUAL_CORRELATION_V2_MATH_EXIT_ZERO" then
    Error("157eh driver: producer/checker common process");
  fi;
  D972FDC2ProducerRaw:=D972FDC2Read(D972FDC2ProducerLog,"producer log");;
  D972FDC2TerminalCount:=0;;
  for D972FDC2Token in ["B345_E4_FULL_D2_QSTAR_SEPARATOR",
      "B345_E4_FULL_D2_ACTIVE_TRANSLATION",
      "B345_E4_FULL_D2_UNKNOWN_RESOURCE",
      "B345_E4_FULL_D2_UNKNOWN_INPUT"] do
    D972FDC2TerminalCount:=D972FDC2TerminalCount+
      D972FDC2Count(D972FDC2ProducerRaw,D972FDC2Token);;
  od;
  if D972FDC2TerminalCount<>1 or
     D972FDC2Count(D972FDC2ProducerRaw,
       "D972_B345_FULL_D2_DUAL_CORRELATION_V2_PRODUCER_PASS")<>1 then
    Error("157eh driver: producer terminal/exit markers");
  fi;
  D972FDC2CheckerRaw:=D972FDC2Read(D972FDC2CheckerLog,"checker log");;
  if D972FDC2Count(D972FDC2CheckerRaw,
       "D972_B345_FULL_D2_DUAL_CORRELATION_V2_CHECKER_PASS")<>1 then
    Error("157eh driver: checker PASS marker");
  fi;
  D972FDC2TimingRaw:=D972FDC2Read(D972FDC2Timing,"common deadline timing");;
  if D972FDC2Count(D972FDC2TimingRaw,"producer_elapsed=")<>1 or
     D972FDC2Count(D972FDC2TimingRaw,"checker_initial_remaining=")<>1 or
     D972FDC2Count(D972FDC2TimingRaw,"final_margin=")<>1 then
    Error("157eh driver: common deadline ledger");
  fi;
  Print("B345_FULL_D2_DUAL_CORRELATION_V2_GHA_DRIVER_PASS mode=full artifact_sha256=",
    HexSHA256(D972FDC2Read(D972FDC2Artifact,"final artifact")),"\n");;
fi;
