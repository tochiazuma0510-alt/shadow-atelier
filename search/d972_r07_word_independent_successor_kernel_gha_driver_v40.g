#############################################################################
## A4 v40 RESUME continuation for the v22 producer and v28 checker.
## ASCII only.  The accepted run-33501732575 row-25 chain is exact-pinned.
#############################################################################
if not IsBound(D386Mode) then Error("task446 MODE required"); fi;
if D386Mode<>"RESUME" then Error("task446 v40 requires RESUME"); fi;

D446V39:="search/d972_r07_word_independent_successor_kernel_gha_driver_v39.g";;
D446V39Bytes:=6005;;
D446V39SHA:="3494d194115d7cb2f52ac1c1f8cedb43719f8ea4088ecc604b6aaa6fff9a5d4f";;
D446Base:="search/d972_r07_word_independent_successor_kernel_gha_driver_v30.g";;
D446BaseBytes:=76229;;
D446BaseSHA:="bacea39ac0615e0051d5cb59356f45f7fd8b8cd6867bad7b2bc2ec286949575c";;
D446Inner:="ci/out/a4_task446_inner.g";;

D446CanonicalBaseBytes:=25581;;
D446CanonicalBaseSHA:="595213bab8936ef10e94ce90ccf526c105d02d871c4dc5d02b6c76cb51593445";;
D446SourceDeltaBytes:=3551;;
D446SourceDeltaSHA:="1d9818a7f9b867ebdefb751b7309aca22db5d6dccac917fddeb494bc18dbe1b5";;
D446SourceHeadBytes:=700;;
D446SourceHeadSHA:="297c91e13dce929925246b19fa9735a57b2656d9875d35b347773c918f65b1c0";;
D446DeltaBytes:=3551;;
D446DeltaSHA:="d1f0ffdda299316ff1805f7a565ffe012fed63001bca74f0bc9e3ef2aeaf0e19";;
D446HeadBytes:=700;;
D446HeadSHA:="a8181cb36651403b7a20386a4b8d63ea301ccdda09ce5d7d8f202e3799a24d08";;

D446OldBasePath:="d972_r07_word_independent_successor_kernel_v39.producer.base.checkpoint.json";;
D446NewBasePath:="d972_r07_word_independent_successor_kernel_v40.producer.base.checkpoint.json";;
D446OldSegmentPath:="d972_r07_word_independent_successor_kernel_v39.producer.head.checkpoint.json.delta.00000001.json";;
D446NewSegmentPath:="d972_r07_word_independent_successor_kernel_v40.producer.head.checkpoint.json.delta.00000001.json";;
D446OldChain:="995cb4ff1b686b69923d0f70e7473ef36147bb546e8f3df530da7bd1142ea7d6";;
D446NewChain:="2fea1d5275a3bf03170fe25bfff70218601a41996cc20416220a56fbb7017ee0";;
D446OldDeltaSeal:="6fed4cb5643fa392bcc5ad7dce38832a5a92f046e5bfb27105e323b991aaad57";;
D446NewDeltaSeal:="dcdbf2da88ef7ec4f809e12c716cbb694077a626b2238d48f79735e9806a357d";;
D446OldHeadSeal:="07193a8d9147026a4e826fe4225a347b82a4ee84c98673541b1bde8688deb846";;
D446NewHeadSeal:="bc70c9582bc9abd2085ea07f487bc0d92c7130d46cecbc3728b023b1ece8ef8f";;

D446SourceDeltaHex:="";;
D446SourceHeadHex:="";;

D446Read:=function(path)
 local raw;
 raw:=StringFile(path);;
 if raw=fail or Length(raw)=0 then Error("task446 missing input ",path); fi;
 return raw;
end;;
D446Count:=function(raw,needle)
 local i,n,m,count;
 n:=Length(raw);; m:=Length(needle);; count:=0;;
 if m=0 then Error("task446 empty needle"); fi;
 if n<m then return 0; fi;
 for i in [1..n-m+1] do
  if raw{[i..i+m-1]}=needle then count:=count+1;; fi;
 od;
 return count;
end;;
D446ReplaceOnce:=function(raw,old,new)
 if D446Count(raw,old)<>1 then Error("task446 replacement cardinality"); fi;
 return ReplacedString(raw,old,new);
end;;
D446ReplaceAll:=function(raw,old,new)
 if D446Count(raw,old)=0 then Error("task446 version marker absent"); fi;
 while D446Count(raw,old)>0 do raw:=ReplacedString(raw,old,new); od;
 return raw;
end;;
D446HexDecode:=function(hex)
 local out,i,hi,lo;
 if Length(hex) mod 2<>0 then Error("task446 seed hex length"); fi;
 out:="";
 for i in [1,3..Length(hex)-1] do
  hi:=Position("0123456789abcdef",hex[i])-1;;
  lo:=Position("0123456789abcdef",hex[i+1])-1;;
  if hi<0 or lo<0 then Error("task446 seed hex digit"); fi;
  Add(out,CharInt(16*hi+lo));;
 od;
 return out;
end;;

## Authenticate the exact accepted source artifacts before rebinding only their
## equal-length v39 path strings and dependent chain/seal fields to v40.
D446DeltaRaw:=D446HexDecode(D446SourceDeltaHex);;
if Length(D446DeltaRaw)<>D446SourceDeltaBytes or HexSHA256(D446DeltaRaw)<>D446SourceDeltaSHA then
 Error("task446 source delta drift");
fi;
D446DeltaRaw:=D446ReplaceOnce(D446DeltaRaw,D446OldBasePath,D446NewBasePath);;
D446DeltaRaw:=D446ReplaceOnce(D446DeltaRaw,D446OldChain,D446NewChain);;
D446DeltaRaw:=D446ReplaceOnce(D446DeltaRaw,D446OldDeltaSeal,D446NewDeltaSeal);;
if Length(D446DeltaRaw)<>D446DeltaBytes or HexSHA256(D446DeltaRaw)<>D446DeltaSHA then
 Error("task446 rebound delta drift");
fi;

D446HeadRaw:=D446HexDecode(D446SourceHeadHex);;
if Length(D446HeadRaw)<>D446SourceHeadBytes or HexSHA256(D446HeadRaw)<>D446SourceHeadSHA then
 Error("task446 source HEAD drift");
fi;
D446HeadRaw:=D446ReplaceOnce(D446HeadRaw,D446OldBasePath,D446NewBasePath);;
D446HeadRaw:=D446ReplaceOnce(D446HeadRaw,D446OldSegmentPath,D446NewSegmentPath);;
D446HeadRaw:=D446ReplaceOnce(D446HeadRaw,D446SourceDeltaSHA,D446DeltaSHA);;
D446HeadRaw:=D446ReplaceOnce(D446HeadRaw,D446OldChain,D446NewChain);;
D446HeadRaw:=D446ReplaceOnce(D446HeadRaw,D446OldHeadSeal,D446NewHeadSeal);;
if Length(D446HeadRaw)<>D446HeadBytes or HexSHA256(D446HeadRaw)<>D446HeadSHA then
 Error("task446 rebound HEAD drift");
fi;

## Pin the exact v39 predecessor as well as its frozen v30 reconstruction base.
D446V39Raw:=D446Read(D446V39);;
if Length(D446V39Raw)<>D446V39Bytes or HexSHA256(D446V39Raw)<>D446V39SHA then
 Error("task446 frozen v39 driver drift");
fi;
D446Raw:=D446Read(D446Base);;
if Length(D446Raw)<>D446BaseBytes or HexSHA256(D446Raw)<>D446BaseSHA then
 Error("task446 frozen v30 driver drift");
fi;
if D446Count(D446Raw,"D386ProducerCheckpointBytes:=25581;;")<>1 or
   D446Count(D446Raw,"D386ProducerCheckpointSHA:=\"595213bab8936ef10e94ce90ccf526c105d02d871c4dc5d02b6c76cb51593445\";;")<>1 then
 Error("task446 canonical base pin drift");
fi;

D446Raw:=D446ReplaceAll(D446Raw,"v30","v40");;
D446Pairs:=[
 ["D345Producer:=\\\\\\\"search/d972_r07_word_independent_successor_kernel_v16.py\\\\\\\";;",
  "D345Producer:=\\\\\\\"search/d972_r07_word_independent_successor_kernel_v22.py\\\\\\\";;"],
 ["D345Checker:=\\\\\\\"crosscheck/check_d972_r07_word_independent_successor_kernel_v22.py\\\\\\\";;",
  "D345Checker:=\\\\\\\"crosscheck/check_d972_r07_word_independent_successor_kernel_v28.py\\\\\\\";;"],
 ["[D345Producer,15991,\\\\\\\"bbd2c2093da3f18d2ea298c5d6955d987d4acbfc6eeb2dc9665abdad556bb2a7\\\\\\\"],",
  "[D345Producer,4055,\\\\\\\"0186a8711ae356d1d01d7ccbd4e618ec5d19fa36442812a5dcfa8c452837d2c2\\\\\\\"],"],
 ["[D345Checker,6579,\\\\\\\"91ae327d9a983136cc5a1ac9188dc1ea11f9e553aef606e8bc4bf45cb9bd819a\\\\\\\"],",
  "[D345Checker,11048,\\\\\\\"c2c1629dc225ebea085b72d1900d7684f4c4184f8e064da8ec4057dc921d2bfa\\\\\\\"],"],
 ["D345PCheckpoint:=\\\\\\\"ci/out/d972_r07_word_independent_successor_kernel_v40.producer.checkpoint.json\\\\\\\";;",
  "D345PCheckpoint:=\\\\\\\"ci/out/d972_r07_word_independent_successor_kernel_v40.producer.head.checkpoint.json\\\\\\\";;"],
 ["D386InstallSeed(\"ci/out/d972_r07_word_independent_successor_kernel_v40.producer.checkpoint.json\"",
  "D386InstallSeed(\"ci/out/d972_r07_word_independent_successor_kernel_v40.producer.base.checkpoint.json\""],
 [" D386InstallSeed(\"ci/out/d972_r07_word_independent_successor_kernel_v40.checker.checkpoint.json\"",
  Concatenation(" D386InstallSeed(\"ci/out/d972_r07_word_independent_successor_kernel_v40.producer.head.checkpoint.json.delta.00000001.json\",\n",
                "                 D446DeltaRaw,D446DeltaBytes,D446DeltaSHA);;\n",
                " D386InstallSeed(\"ci/out/d972_r07_word_independent_successor_kernel_v40.producer.head.checkpoint.json\",\n",
                "                 D446HeadRaw,D446HeadBytes,D446HeadSHA);;\n",
                " D386InstallSeed(\"ci/out/d972_r07_word_independent_successor_kernel_v40.checker.checkpoint.json\"")]
];;
for D446Pair in D446Pairs do
 D446Raw:=D446ReplaceOnce(D446Raw,D446Pair[1],D446Pair[2]);;
od;
for D446Pair in D446Pairs do
 if D446Count(D446Raw,D446Pair[1])<>0 or D446Count(D446Raw,D446Pair[2])<>1 then
  Error("task446 post-replacement gate");
 fi;
od;

## The inherited installer accepts an existing file only when byte-identical.
## Seed order is base, accepted delta 1, nonempty HEAD, then checker base.
Exec("mkdir -p ci/out");;
D446Stream:=OutputTextFile(D446Inner,false);;
if D446Stream=fail then Error("task446 inner driver open"); fi;
SetPrintFormattingStatus(D446Stream,false);;
PrintTo(D446Stream,D446Raw);;
CloseStream(D446Stream);;
if D446Read(D446Inner)<>D446Raw then Error("task446 inner readback"); fi;
D386Mode:=D386Mode;;
Read(D446Inner);;
