#############################################################################
## A4 v29 PRODUCTION/RESUME driver for the compact v16/v20 owners.
## ASCII only. Frozen v24 driver is restored directly.
#############################################################################
if not IsBound(D386Mode) then Error("task397 MODE required"); fi;
if D386Mode<>"PRODUCTION" and D386Mode<>"RESUME" then
 Error("task397 MODE must be PRODUCTION or RESUME");
fi;

