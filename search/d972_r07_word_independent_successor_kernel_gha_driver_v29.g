D386Read:=function(path)
 local raw;
 raw:=StringFile(path);;
 if raw=fail or Length(raw)=0 then Error("task397 missing input ",path); fi;
 return raw;
end;;
D386Count:=function(raw,needle)
 local i,n,m,count;
 n:=Length(raw);; m:=Length(needle);; count:=0;;
 if m=0 then Error("task397 empty needle"); fi;
 if n<m then return 0; fi;
 for i in [1..n-m+1] do
  if raw{[i..i+m-1]}=needle then count:=count+1;; fi;
 od;
 return count;
end;;
D386ReplaceOnce:=function(raw,old,new)
 if D386Count(raw,old)<>1 then Error("task397 replacement cardinality"); fi;
 return ReplacedString(raw,old,new);
end;;

D386Raw:=D386Read(D386Base);;
if Length(D386Raw)<>D386BaseBytes or HexSHA256(D386Raw)<>D386BaseSHA then
 Error("task397 frozen v24 driver drift");
fi;
for D386Pair in D386Pairs do
 D386Raw:=D386ReplaceOnce(D386Raw,D386Pair[1],D386Pair[2]);;
od;
for D386Pair in D386Pairs do
 if D386Count(D386Raw,D386Pair[1])<>0 or D386Count(D386Raw,D386Pair[2])<>1 then
  Error("task397 post-replacement gate");
 fi;
od;
Exec("mkdir -p ci/out");;
D386ProducerCheckpointBytes:=25581;;
D386ProducerCheckpointSHA:="595213bab8936ef10e94ce90ccf526c105d02d871c4dc5d02b6c76cb51593445";;
D386ProducerCheckpointHex:=Concatenation("","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","");;
D386CheckerCheckpointBytes:=8991;;
D386CheckerCheckpointSHA:="b96919b38272d87a6885da98a18603065d1c2ccf805cd2c4f65dd22e32ed7af2";;
D386CheckerCheckpointHex:=Concatenation("","","","","","","","","","","","","","","","","","");;
D386HexDecode:=function(hex)
 local out,i,hi,lo;
 if Length(hex) mod 2<>0 then Error("task397 seed hex length"); fi;
 out:="";
 for i in [1,3..Length(hex)-1] do
  hi:=Position("0123456789abcdef",hex[i])-1;;
  lo:=Position("0123456789abcdef",hex[i+1])-1;;
  if hi<0 or lo<0 then Error("task397 seed hex digit"); fi;
  out:=Concatenation(out,CharInt(16*hi+lo));;
 od;
 return out;
end;;
D386InstallSeed:=function(path,raw,expected_bytes,expected_sha)
 local stream,check;
 if IsExistingFile(path) then
  check:=D386Read(path);;
  if Length(check)<>expected_bytes or HexSHA256(check)<>expected_sha then
   Error("task397 seed checkpoint hash mismatch ",path);
  fi;
  return;
 fi;
 if Length(raw)<>expected_bytes or HexSHA256(raw)<>expected_sha then
  Error("task397 embedded checkpoint hash mismatch ",path);
 fi;
 stream:=OutputTextFile(path,false);;
 if stream=fail then Error("task397 seed checkpoint open ",path); fi;
 SetPrintFormattingStatus(stream,false);;
 PrintTo(stream,raw);;
 CloseStream(stream);;
 check:=D386Read(path);;
 if Length(check)<>expected_bytes or HexSHA256(check)<>expected_sha then
  Error("task397 seeded checkpoint hash mismatch ",path);
 fi;
end;;
if D386Mode="RESUME" then
 D386InstallSeed("ci/out/d972_r07_word_independent_successor_kernel_v29.producer.checkpoint.json",
                 D386HexDecode(D386ProducerCheckpointHex),D386ProducerCheckpointBytes,D386ProducerCheckpointSHA);;
 D386InstallSeed("ci/out/d972_r07_word_independent_successor_kernel_v29.checker.checkpoint.json",
                 D386HexDecode(D386CheckerCheckpointHex),D386CheckerCheckpointBytes,D386CheckerCheckpointSHA);;
fi;;

D386Stream:=OutputTextFile(D386Inner,false);;
if D386Stream=fail then Error("task397 inner driver open"); fi;
SetPrintFormattingStatus(D386Stream,false);;
PrintTo(D386Stream,D386Raw);;
CloseStream(D386Stream);;
if D386Read(D386Inner)<>D386Raw then Error("task397 inner readback"); fi;
D385Mode:=D386Mode;;
Read(D386Inner);;



