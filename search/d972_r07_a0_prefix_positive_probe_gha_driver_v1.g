D432RecoveryCommand:=Concatenation("bash -lc 'set -eu; mkdir -p ci/in; test ! -e ",D432RecoveryReceipt,"; test ! -L ",D432RecoveryReceipt,"; if [ -e ",D432RecoveryZip," ] || [ -L ",D432RecoveryZip," ] || [ -e ",D432Input," ] || [ -L ",D432Input," ] || [ -e ",D432RecoverySeal," ] || [ -L ",D432RecoverySeal," ]; then names=$(unzip -Z1 ci/in/d972_r07_a0_prefix_positive_probe_v1_recovery.zip); test \"$(printf \"%s\\n\" \"$names\" | wc -l)\" -eq 6; test \"$(printf \"%s\\n\" \"$names\" | sort -u | wc -l)\" -eq 6; test \"$(printf \"%s\\n\" \"$names\" | grep -Fxc \"d972_r07_a0_pb34_direct_quotient_owner_v12.json\")\" -eq 1; test \"$(printf \"%s\\n\" \"$names\" | grep -Fxc \"d972_r07_a0_pb34_direct_quotient_owner_v12_checker.log\")\" -eq 1; test \"$(printf \"%s\\n\" \"$names\" | grep -Fxc \"d972_r07_a0_pb34_direct_quotient_owner_v12_output.checkpoint\")\" -eq 1; test \"$(printf \"%s\\n\" \"$names\" | grep -Fxc \"d972_r07_a0_pb34_direct_quotient_owner_v12_producer.log\")\" -eq 1; test \"$(printf \"%s\\n\" \"$names\" | grep -Fxc \"driver.g\")\" -eq 1; test \"$(printf \"%s\\n\" \"$names\" | grep -Fxc \"run.log\")\" -eq 1; test -f ",D432RecoveryZip,"; test -f ",D432Input,"; test -f ",D432RecoverySeal,"; test ! -L ",D432RecoveryZip,"; test ! -L ",D432Input,"; test ! -L ",D432RecoverySeal,"; test \"$(wc -c < ",D432RecoveryZip,")\" -eq ",String(D432RecoveryZipBytes),"; printf \"%s  %s\\n\" \"",D432RecoveryZipSHA,"\" ",D432RecoveryZip," | sha256sum -c -; test \"$(wc -c < ",D432Input,")\" -eq ",String(D432RecoveryBytes),"; printf \"%s  %s\\n\" \"",D432RecoverySHA,"\" ",D432Input," | sha256sum -c -; test \"$(cat ",D432RecoverySeal,")\" = \"D972-A0V12-RECOVERY-SEAL1 ",D432RecoveryZipSHA," ",D432RecoverySHA,"\"; else ztmp=$(mktemp ci/in/d972-r07-a0-recovery-XXXXXX.zip.tmp); cptmp=$(mktemp ci/out/d972-r07-a0-recovery-XXXXXX.checkpoint.tmp); trap \"rm -f \\\"$ztmp\\\" \\\"$cptmp\\\"\" EXIT; curl --fail --location --retry 3 --output \"$ztmp\" ",D432RecoveryURL,"; test \"$(wc -c < \"$ztmp\")\" -eq ",String(D432RecoveryZipBytes),"; printf \"%s  %s\\n\" \"",D432RecoveryZipSHA,"\" \"$ztmp\" | sha256sum -c -; names=$(unzip -Z1 \"$ztmp\"); test \"$(printf \"%s\\n\" \"$names\" | wc -l)\" -eq 6; test \"$(printf \"%s\\n\" \"$names\" | sort -u | wc -l)\" -eq 6; test \"$(printf \"%s\\n\" \"$names\" | grep -Fxc \"d972_r07_a0_pb34_direct_quotient_owner_v12.json\")\" -eq 1; test \"$(printf \"%s\\n\" \"$names\" | grep -Fxc \"d972_r07_a0_pb34_direct_quotient_owner_v12_checker.log\")\" -eq 1; test \"$(printf \"%s\\n\" \"$names\" | grep -Fxc \"d972_r07_a0_pb34_direct_quotient_owner_v12_output.checkpoint\")\" -eq 1; test \"$(printf \"%s\\n\" \"$names\" | grep -Fxc \"d972_r07_a0_pb34_direct_quotient_owner_v12_producer.log\")\" -eq 1; test \"$(printf \"%s\\n\" \"$names\" | grep -Fxc \"driver.g\")\" -eq 1; test \"$(printf \"%s\\n\" \"$names\" | grep -Fxc \"run.log\")\" -eq 1; unzip -p \"$ztmp\" \"",D432RecoveryEntry,"\" > \"$cptmp\"; test \"$(wc -c < \"$cptmp\")\" -eq ",String(D432RecoveryBytes),"; printf \"%s  %s\\n\" \"",D432RecoverySHA,"\" \"$cptmp\" | sha256sum -c -; test ! -e ",D432RecoveryZip,"; test ! -L ",D432RecoveryZip,"; test ! -e ",D432Input,"; test ! -L ",D432Input,"; test ! -e ",D432RecoverySeal,"; test ! -L ",D432RecoverySeal,"; mv \"$ztmp\" ",D432RecoveryZip,"; mv \"$cptmp\" ",D432Input,"; printf \"D972-A0V12-RECOVERY-SEAL1 ",D432RecoveryZipSHA," ",D432RecoverySHA,"\\n\" > ",D432RecoverySeal,"; chmod 600 ",D432RecoverySeal,"; fi; rtmp=$(mktemp ci/in/d972-r07-a0-recovery-XXXXXX.receipt.tmp); printf \"%s\\n\" \"",D432RecoveryReceiptText,"\" > \"$rtmp\"; mv \"$rtmp\" ",D432RecoveryReceipt,"; trap - EXIT' ");;Exec(D432RecoveryCommand);;if not IsExistingFile(D432RecoveryReceipt) then Error("task432 recovery receipt missing");fi;;if D432Read(D432RecoveryReceipt)<>Concatenation(D432RecoveryReceiptText,"\n") then Error("task432 recovery receipt mismatch");fi;;if not IsExistingFile(D432RecoverySeal) then Error("task432 recovery artifact not authenticated");fi;;
