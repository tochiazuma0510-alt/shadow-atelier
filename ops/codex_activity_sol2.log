 207:   local a1, a2, a3, a4, term1, term2, term3;
 208:   a1 := EmP(m);
 209:   a3 := SigmaP(f, m);
 210:   a2 := SigmaP(a3, m);
 211:   a4 := f;
 212:   term1 := Cs(a1+a2, a3);
 213:   term2 := Cs(a1, a2);
 214:   term3 := Cs(a1+a2+a3, a4);
 215:   return term3 + term1 + term2;   # additive in C = Z^2
 216: end;;
 217: 
 218: Xi := function(f, m) return Concatenation(QTheta(f), QN(f,m)); end;;  # 4-vector in C x C
 219: 
 220: # ================================================================================
 221: # v3.1 F5/F12.3 postcondition: for basis-generator representation of K, check
 222: #   n_i * piB(e_i,e_j) = 0 = n_j * piB(e_i,e_j)   and   piB(e_i,e_j) = piB(e_j,e_i)
 223: # piB(u,v) := (b_theta(u,v), b_N(u,v)) with b_theta(u,v):=beta(theta(v),u),
 224: #             b_N(u,v):=beta(sigma^2(v), sigma(u)+u) + beta(sigma(v), u)   [manifest_spec_e2_actions.md]
 225: # (computed directly via beta + known theta_bar/sigma_bar -- no group collection needed for piB
 226: # itself, only for Xi/q_theta/q_N as derived above.)
 227: # ================================================================================
 228: BTheta := function(u, v) return BetaAC(ThetaP(v), u); end;;
 229: BN := function(u, v, m)
 230:   local sv2, su, term1, term2;
 231:   sv2 := SigmaP(SigmaP(v,m),m);
 232:   su := SigmaP(u,m);
 233:   term1 := BetaAC(sv2, su+u);
 234:   term2 := BetaAC(SigmaP(v,m), u);
 235:   return term1+term2;
 236: end;;
 237: PiB := function(u,v,m) return Concatenation(BTheta(u,v), BN(u,v,m)); end;;
 238: 
 239: # ================================================================================
 240: # per-(j,m) three-stage evaluation. Runs on the linear-stage system ALREADY computed and
 241: # verified in workorder5 item2 (search/e19.g at class 5): L != empty for ALL m=0..63 (Z2-solvable
 242: # for every j simultaneously). This function recomputes the linear stage independently here too
 243: # (does not just assume the e19 result) since this is a DIFFERENT script/object nominally, then
 244: # adds the quadratic/obstruction stage.
 245: # ================================================================================
 246: IntBool := function(b) if b then return 1; else return 0; fi; end;;
 247: 
 248: BuildLinearSystem := function(m)
 249:   local n, thMat, smMat, sm2Mat, b, rows, rhs, i, k, j, val;
 250:   n := NN();
 251:   thMat := MatOf(ThetaP);;
 252:   smMat := MatOf(x -> SigmaP(x,m));;
 253:   sm2Mat := [];
 254:   for k in [1..n] do
 255:     val := ZeroP();
 256:     for j in [1..n] do
 257:       if smMat[k][j] <> 0 then val := val + smMat[k][j]*smMat[j]; fi;
 258:     od;
 259:     Add(sm2Mat, val);
 260:   od;
 261:   b := EmP(m);;
 262:   rows := [];;  rhs := [];;
 263:   for i in [1..n] do
 264:     rows[i] := List([1..n], k -> thMat[k][i] + IntBool(i=k));
 265:     rhs[i] := 0;
 266:   od;
 267:   for i in [1..n] do
 268:     rows[n+i] := List([1..n], k -> IntBool(i=k) + smMat[k][i] + sm2Mat[k][i]);
 269:     rhs[n+i] := -b[i];
 270:   od;
 271:   return rec(n:=n, rows:=rows, rhs:=rhs, b:=b);
 272: end;;
