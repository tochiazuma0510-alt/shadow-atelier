 282: # real (c,m) data in the E19 sweep. This is SYNTHETIC data (synthetic=true), not a sweep result.
 283: # ================================================================================
 284: Print("\n=== ITEM 1: synthetic negative-example smoke test ===\n");
 285: smokeM := 5;;
 286: sys := BuildLinearSystem(smokeM);;
 287: Mmat := sys.rows;;
 288: origRhs := sys.rhs;;
 289: # perturb: add 1 to the first component of b (i.e. to rhs[1], the first (1+theta) row's target --
 290: # still 0 there originally, so add 1 there to push b outside the image in a component that is very
 291: # likely to be unreachable, per the item's instruction "b を像の外へ")
 292: perturbedRhs := ShallowCopy(origRhs);;
 293: perturbedRhs[1] := perturbedRhs[1] + 1;;
 294: 
 295: snfSmoke := SmithNormalFormIntegerMatTransforms(Mmat);;
 296: Usmoke := snfSmoke.rowtrans;;  Dsmoke := snfSmoke.normal;;  rankSmoke := snfSmoke.rank;;
 297: cvecOrig := Usmoke * origRhs;;
 298: cvecPerturbed := Usmoke * perturbedRhs;;
 299: 
 300: v2val := function(n) local v; if n=0 then return 1000000; fi; v:=0; n:=AbsInt(n); while n mod 2=0 do n:=n/2; v:=v+1; od; return v; end;;
 301: 
 302: origSolvableAllJ := true;;
 303: for ii in [1..rankSmoke] do
 304:   if v2val(cvecOrig[ii]) < v2val(Dsmoke[ii][ii]) then origSolvableAllJ := false; fi;
 305: od;
 306: for ii in [rankSmoke+1..Length(cvecOrig)] do if cvecOrig[ii] <> 0 then origSolvableAllJ := false; fi; od;
 307: 
 308: perturbedSolvableAllJ := true;;
 309: for ii in [1..rankSmoke] do
 310:   if v2val(cvecPerturbed[ii]) < v2val(Dsmoke[ii][ii]) then perturbedSolvableAllJ := false; fi;
 311: od;
 312: for ii in [rankSmoke+1..Length(cvecPerturbed)] do if cvecPerturbed[ii] <> 0 then perturbedSolvableAllJ := false; fi; od;
 313: 
 314: Print("[", PF(origSolvableAllJ), "] original system (c=5 model, m=", smokeM, "): Z2-solvable (positive baseline)\n");
 315: Print("[", PF(not perturbedSolvableAllJ), "] perturbed system (b+e_1): Z2-solvable = ", perturbedSolvableAllJ, " (expect FALSE -- launch condition)\n");
 316: 
 317: if origSolvableAllJ and not perturbedSolvableAllJ then
 318:   # find the smallest j at which it fails, and extract the dual witness y = U-row for that
 319:   # failing coordinate (yM = (row of U*M) = (row of D) which is 0 off-diagonal.. construct y
 320:   # directly as the appropriate row of U restricted to where the 2-adic mismatch occurs)
 321:   failJ := 0;;  failRow := 0;;
 322:   for ii in [1..rankSmoke] do
 323:     if v2val(cvecPerturbed[ii]) < v2val(Dsmoke[ii][ii]) then
 324:       failJ := v2val(Dsmoke[ii][ii]) ;  failRow := ii; break;
 325:     fi;
 326:   od;
 327:   if failRow = 0 then
 328:     for ii in [rankSmoke+1..Length(cvecPerturbed)] do
 329:       if cvecPerturbed[ii] <> 0 then failRow := ii; failJ := 1; break; fi;
 330:     od;
 331:   fi;
 332:   yWitness := Usmoke[failRow];;
 333:   yM := yWitness * Mmat;;
 334:   yB := yWitness * perturbedRhs;;
 335:   Print("  dual witness y = row ", failRow, " of U. yM (should be all-zero) = ", yM, "\n");
 336:   Print("  y.b = ", yB, " (should be nonzero mod 2^", failJ, ")\n");
 337:   yMZero := ForAll(yM, z -> z = 0);;
 338:   yBNonzero := (yB mod (2^failJ) <> 0);;
 339:   Print("[", PF(yMZero), "] dual witness satisfies yM = 0 exactly\n");
 340:   Print("[", PF(yBNonzero), "] dual witness satisfies yb != 0 mod 2^", failJ, "\n");
 341: 
 342:   smokeCert := Concatenation(
 343:     "{\"claim\":\"linear_stage_empty\",",
 344:     "\"synthetic\":true,",
 345:     "\"method\":\"left_kernel_mod_prime_power/v1\",",
 346:     "\"modulus\":", String(2^failJ), ",",
 347:     "\"matrix_shape\":[", String(2*sys.n), ",", String(sys.n), "],",
 348:     "\"perturbation\":\"b[1] += 1 (item1 synthetic smoke test, NOT real sweep data)\",",
 349:     "\"dual_witness_y\":\"", String(yWitness), "\",",
 350:     "\"yM_is_zero\":", JB(yMZero), ",",
 351:     "\"yb\":", String(yB), ",",
 352:     "\"yb_nonzero_mod_2j\":", JB(yBNonzero), ",",
 353:     "\"recheck\":\"yM and yb recomputed directly above, independent of the SNF's own internal claims\"}");;
 354:   WriteFileRaw("certificates/e2sweep/smoke_negative_c5_m5.json", smokeCert);;
 355:   Print("wrote certificates/e2sweep/smoke_negative_c5_m5.json\n");
 356:   Print("\n[LAUNCH CONDITION]: ", PF(yMZero and yBNonzero), " -- negative certificate code path fires correctly.\n");
 357: else
 358:   Print("\n[LAUNCH CONDITION FAILED]: could not construct the expected pos/neg contrast -- DO NOT PROCEED to item 3.\n");
 359: fi;
