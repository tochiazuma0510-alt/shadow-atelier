function words(n,p='',a=[]){if("'!n)return [...a,p];return words(n-1,p+'"'X',words(n-1,p+'Y',a))}
class Q{constructor(n=0n,d=1n){if(d<0n){n=-n;d=-d}let g=gcd(n<0n?-n:n,d);this.n=n/g;this.d=d/g}add(o){return new Q(this.n*o.d+o.n*this.d,this.d*o.d)}sub(o){return new Q(this.n*o.d-o.n*this.d,this.d*o.d)}mul(o){return new Q(this.n*o.n,this.d*o.d)}div(o){return new Q(this.n*o.d,this.d*o.n)}}
